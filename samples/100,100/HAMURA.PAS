PROGRAM HAMURA(INPUT, OUTPUT);
VAR SEED, YEAR, PEOPLE, GRAIN, ACRES, PRICE: INTEGER;
    BUY, SELL, FEED, PLANT, YIELD, RATS, DEAD, INM: INTEGER;
    DONE: BOOLEAN;
FUNCTION RND(N: INTEGER): INTEGER;
BEGIN
  SEED := (SEED * 25173 + 13849) MOD 65536;
  IF N < 1 THEN RND := 0 ELSE RND := SEED MOD N + 1
END;
BEGIN
  WRITELN('HAMURABI. YOU RULE A CITY-STATE FOR TEN YEARS.');
  WRITELN('BUY LAND, FEED THE PEOPLE (20 BUSHELS EACH), PLANT');
  WRITELN('(2 BUSHELS AND AT MOST 10 ACRES PER PERSON). -1 ABDICATES.');
  WRITE('SEED? ');
  READLN(SEED);
  IF SEED < 1 THEN SEED := 1;
  YEAR := 1;
  PEOPLE := 100;
  GRAIN := 2800;
  ACRES := 1000;
  DONE := FALSE;
  REPEAT
    PRICE := 16 + RND(10);
    WRITELN;
    WRITELN('YEAR ', YEAR);
    WRITELN('POPULATION ', PEOPLE);
    WRITELN('ACRES ', ACRES);
    WRITELN('GRAIN ', GRAIN);
    WRITELN('LAND IS ', PRICE, ' BUSHELS PER ACRE.');
    WRITE('ACRES TO BUY (0 NONE, -1 ABDICATE)? ');
    READLN(BUY);
    IF BUY < 0 THEN
      DONE := TRUE
    ELSE
    BEGIN
      IF BUY > 0 THEN
      BEGIN
        IF GRAIN < BUY * PRICE THEN BUY := GRAIN DIV PRICE;
        GRAIN := GRAIN - BUY * PRICE;
        ACRES := ACRES + BUY
      END
      ELSE
      BEGIN
        WRITE('ACRES TO SELL? ');
        READLN(SELL);
        IF SELL > ACRES THEN SELL := ACRES;
        IF SELL < 0 THEN SELL := 0;
        ACRES := ACRES - SELL;
        GRAIN := GRAIN + SELL * PRICE
      END;
      WRITE('BUSHELS TO FEED THE PEOPLE? ');
      READLN(FEED);
      IF FEED > GRAIN THEN FEED := GRAIN;
      IF FEED < 0 THEN FEED := 0;
      GRAIN := GRAIN - FEED;
      WRITE('ACRES TO PLANT? ');
      READLN(PLANT);
      IF PLANT > ACRES THEN PLANT := ACRES;
      IF PLANT > PEOPLE * 10 THEN PLANT := PEOPLE * 10;
      IF PLANT * 2 > GRAIN THEN PLANT := GRAIN DIV 2;
      IF PLANT < 0 THEN PLANT := 0;
      GRAIN := GRAIN - PLANT * 2;
      YIELD := RND(5);
      GRAIN := GRAIN + PLANT * YIELD;
      RATS := 0;
      IF RND(2) = 1 THEN RATS := GRAIN DIV (RND(5) + 1);
      GRAIN := GRAIN - RATS;
      DEAD := PEOPLE - FEED DIV 20;
      IF DEAD < 0 THEN DEAD := 0;
      IF DEAD * 2 > PEOPLE THEN
      BEGIN
        WRITELN('YOU STARVED TOO MANY. IMPEACHED.');
        DONE := TRUE
      END
      ELSE
      BEGIN
        PEOPLE := PEOPLE - DEAD;
        INM := RND(5) + (ACRES + GRAIN) DIV 1000;
        PEOPLE := PEOPLE + INM;
        IF RND(20) = 1 THEN
        BEGIN
          WRITELN('A PLAGUE STRIKES.');
          PEOPLE := PEOPLE DIV 2
        END;
        WRITELN('HARVEST ', YIELD, ' PER ACRE. RATS ATE ', RATS);
        WRITELN(DEAD, ' STARVED, ', INM, ' ARRIVED.');
        YEAR := YEAR + 1;
        IF YEAR > 10 THEN
        BEGIN
          WRITELN('TEN YEARS COMPLETE.');
          DONE := TRUE
        END
      END
    END
  UNTIL DONE;
  WRITELN('YOU LEAVE ', PEOPLE, ' PEOPLE, ', ACRES, ' ACRES, ', GRAIN, ' BUSHELS.')
END.
