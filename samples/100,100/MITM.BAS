10 ON ERROR GOTO 9000
15 X$=SYS(CHR$(6%)+CHR$(-7%)+CHR$(1%))
20 OPEN "KB0:" AS FILE 1, RECORDSIZE 1
30 OPEN "PK:" AS FILE 2, RECORDSIZE 1
40 FIELD #1, 1 AS A$
50 FIELD #2, 1 AS B$
55 P$=""
56 L%=0%
60 WAIT 0
65 GOTO 200
70 GET #1
72 A%=ASC(A$)
74 IF A%=10% THEN IF L%=13% THEN 70
76 L%=A%
80 PRINT A$;
90 LSET B$=A$
100 PUT #2
110 P$=P$+A$
120 GOTO 200
200 GET #2
210 IF LEN(P$)=0 THEN 250
220 IF B$<>LEFT$(P$,1) THEN 248
230 P$=RIGHT$(P$,2)
240 LSET A$=B$
242 PUT #1
244 GOTO 70
248 P$=""
250 PRINT B$;
260 LSET A$=B$
270 PUT #1
280 GOTO 70
800 SLEEP .05
810 GOTO 70
9000 IF ERR=28 THEN 9120
9010 IF ERR<>15 THEN 9100
9020 IF ERL=70 THEN RESUME 200
9030 IF ERL=200 THEN RESUME 800
9040 RESUME 800
9100 PRINT "?ERR";ERR;" AT ";ERL
9120 CLOSE 1
9130 CLOSE 2
9140 END
