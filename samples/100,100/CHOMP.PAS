PROGRAM CHOMP(INPUT, OUTPUT);
CONST H = 4;
      WD = 6;
VAR R, COL, I, J: INTEGER;
    T: ARRAY[1..4, 1..6] OF BOOLEAN;
    DONE: BOOLEAN;
PROCEDURE SHOW;
VAR I, J: INTEGER;
BEGIN
  FOR I := H DOWNTO 1 DO
  BEGIN
    WRITE(I, ' ');
    FOR J := 1 TO WD DO
      IF T[I, J] THEN WRITE('#') ELSE WRITE('.');
    WRITELN
  END;
  WRITELN('  123456  POISON IS 1,1')
END;
PROCEDURE TAKE(RR, CC: INTEGER);
VAR I, J: INTEGER;
BEGIN
  FOR I := RR TO H DO
    FOR J := CC TO WD DO
      T[I, J] := FALSE
END;
PROCEDURE COMP;
VAR I, J: INTEGER;
    FOUND: BOOLEAN;
BEGIN
  FOUND := FALSE;
  FOR I := H DOWNTO 1 DO
    IF NOT FOUND THEN
      FOR J := WD DOWNTO 1 DO
        IF (NOT FOUND) AND T[I, J] AND ((I <> 1) OR (J <> 1)) THEN
        BEGIN
          WRITELN('I CHOMP AT ', I, ',', J);
          TAKE(I, J);
          FOUND := TRUE
        END;
  IF NOT FOUND THEN
  BEGIN
    WRITELN('I HAVE TO TAKE THE POISON.');
    TAKE(1, 1);
    DONE := TRUE
  END
END;
BEGIN
  WRITELN('CHOMP. THE # SQUARES ARE CHOCOLATE. NAME A SQUARE;');
  WRITELN('EVERY SQUARE NORTH AND EAST OF IT IS EATEN. 1,1 IS');
  WRITELN('POISON -- WHOEVER EATS IT LOSES. 0 0 QUITS.');
  FOR I := 1 TO H DO
    FOR J := 1 TO WD DO
      T[I, J] := TRUE;
  DONE := FALSE;
  REPEAT
    SHOW;
    WRITE('ROW COL? ');
    READLN(R, COL);
    IF (R = 0) AND (COL = 0) THEN
      DONE := TRUE
    ELSE IF (R < 1) OR (R > H) OR (COL < 1) OR (COL > WD) THEN
      WRITELN('OFF THE BAR.')
    ELSE IF NOT T[R, COL] THEN
      WRITELN('ALREADY GONE.')
    ELSE
    BEGIN
      TAKE(R, COL);
      IF NOT T[1, 1] THEN
      BEGIN
        WRITELN('YOU ATE THE POISON.');
        DONE := TRUE
      END
      ELSE
        COMP
    END
  UNTIL DONE;
  WRITELN('ENOUGH.')
END.
