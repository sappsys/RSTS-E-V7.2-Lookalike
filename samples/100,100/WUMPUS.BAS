5 EXTEND
10 DIM C(20,3)
20 RANDOMIZE
30 RESTORE \ READ C(I,J) FOR J=1 TO 3 FOR I=1 TO 20
40 PRINT "HUNT THE WUMPUS -- 20 CAVES, EACH WITH 3 TUNNELS."
50 PRINT "MOVE OR SHOOT. PITS AND BATS AND ONE WUMPUS."
60 PRINT "TYPE 0 TO QUIT WHEN ASKED FOR A CAVE."
70 GOSUB 900
80 AR=5
90 PRINT \ PRINT "YOU ARE IN CAVE"; P
100 PRINT "TUNNELS LEAD TO"; C(P,1); C(P,2); C(P,3)
110 F1=0 \ F2=0 \ F3=0
120 FOR J=1 TO 3
130 R=C(P,J)
140 IF R=W THEN F1=1
150 IF R=P1 OR R=P2 THEN F2=1
160 IF R=B1 OR R=B2 THEN F3=1
170 NEXT J
180 IF F1 THEN PRINT "I SMELL A WUMPUS."
190 IF F2 THEN PRINT "I FEEL A DRAFT."
200 IF F3 THEN PRINT "BATS NEARBY."
210 INPUT "MOVE OR SHOOT (M/S)"; A$
220 A$=LEFT$(A$,1)
230 IF A$="s" THEN A$="S"
240 IF A$="m" THEN A$="M"
250 IF A$="S" THEN 400
260 IF A$<>"M" THEN 210
270 INPUT "TO CAVE"; D
280 IF D=0 THEN 850
290 OK=0 \ IF D=C(P,J) THEN OK=1 FOR J=1 TO 3
300 IF OK=1 THEN 310
305 PRINT "NOT CONNECTED." \ GOTO 270
310 P=D
320 IF P<>W THEN 330
325 PRINT "THE WUMPUS GOT YOU." \ GOTO 840
330 IF P<>P1 AND P<>P2 THEN 340
335 PRINT "YYYYIIIIEEEE -- A PIT." \ GOTO 840
340 IF P<>B1 AND P<>B2 THEN 90
350 PRINT "SNATCHED BY SUPER BATS."
360 P=INT(RND*20)+1
370 GOTO 320
400 IF AR>0 THEN 410
405 PRINT "NO ARROWS." \ GOTO 210
410 INPUT "SHOOT INTO CAVE"; D
420 IF D=0 THEN 850
430 OK=0 \ IF D=C(P,J) THEN OK=1 FOR J=1 TO 3
440 IF OK=1 THEN 450
445 PRINT "ARROWS AREN'T THAT CROOKED." \ GOTO 410
450 AR=AR-1
460 IF D<>W THEN 470
465 PRINT "AHA! YOU GOT THE WUMPUS." \ GOTO 840
470 PRINT "MISSED."
480 IF RND<.75 THEN W=C(W,INT(RND*3)+1)
490 IF W<>P THEN 500
495 PRINT "THE WUMPUS WANDERS IN AND EATS YOU." \ GOTO 840
500 IF AR>0 THEN 90
510 PRINT "THAT WAS THE LAST ARROW."
840 INPUT "AGAIN (Y/N)"; A$
845 IF LEFT$(A$,1)="Y" OR LEFT$(A$,1)="y" THEN 70
850 PRINT "ENOUGH."
860 END
900 P=INT(RND*20)+1
910 W=INT(RND*20)+1
920 IF W=P THEN 910
930 P1=INT(RND*20)+1
940 IF P1=P OR P1=W THEN 930
950 P2=INT(RND*20)+1
960 IF P2=P OR P2=W OR P2=P1 THEN 950
970 B1=INT(RND*20)+1
980 IF B1=P OR B1=W OR B1=P1 OR B1=P2 THEN 970
990 B2=INT(RND*20)+1
1000 IF B2=P OR B2=W OR B2=P1 OR B2=P2 OR B2=B1 THEN 990
1010 RETURN
