10 EXTEND
20 ON ERROR GOTO 800
30 S$="" \ D$=""
40 C$=SYS(CHR$(6%)+CHR$(-18%))
50 GOSUB 600
60 IF S$="" THEN INPUT "From-- "; S$
70 IF D$="" THEN INPUT "To-- "; D$
80 T$=S$ \ GOSUB 750 \ S$=T$
90 T$=D$ \ GOSUB 750 \ D$=T$
100 IF S$="" OR D$="" THEN PRINT "?MYCOPY from to" \ END
110 OPEN S$ FOR INPUT AS FILE 1%, RECORDSIZE 512%
120 OPEN D$ FOR OUTPUT AS FILE 2%, RECORDSIZE 512%
130 FIELD #1%, 512% AS A$
140 FIELD #2%, 512% AS B$
150 R=1 \ N=0 \ L%=0%
160 GET #1%, RECORD R
170 L%=RECOUNT
180 IF L%<512% THEN 220
190 LSET B$=A$
200 PUT #2%, RECORD R
210 N=N+512 \ R=R+1 \ GOTO 160
220 CLOSE 2%
230 IF L%=0% THEN 320
240 OPEN D$ FOR APPEND AS FILE 2%, RECORDSIZE 1%
250 FIELD #2%, 1% AS C$
260 B0=(R-1)*512
270 FOR I%=1% TO L%
280 LSET C$=MID$(A$,I%,1%)
290 PUT #2%, RECORD B0+I%
300 NEXT I%
310 N=N+L%
320 CLOSE 1% \ CLOSE 2%
330 PRINT NUM1$(N); " bytes copied"
340 END
600 IF C$="" THEN RETURN
610 T$=C$ \ GOSUB 750 \ C$=T$
620 EQ%=INSTR(C$,"=")
630 IF EQ%=0% THEN 660
640 D$=LEFT$(C$,EQ%-1%) \ S$=RIGHT$(C$,EQ%+1%)
650 RETURN
660 SP%=INSTR(C$," ")
670 IF SP%=0% THEN S$=C$ \ RETURN
680 S$=LEFT$(C$,SP%-1%) \ D$=RIGHT$(C$,SP%+1%)
690 RETURN
750 IF T$="" THEN RETURN
760 IF LEFT$(T$,1)=" " THEN T$=RIGHT$(T$,2) \ GOTO 750
770 IF MID$(T$,LEN(T$),1)=" " THEN T$=LEFT$(T$,LEN(T$)-1) \ GOTO 750
780 RETURN
800 IF ERR<>11 THEN 830
810 IF ERL<>160 THEN 830
820 L%=0% \ RESUME 220
830 IF ERR=10 THEN PRINT "?Protection violation" \ GOTO 850
840 PRINT "?Can't find file or account"
850 CLOSE 1% \ CLOSE 2%
860 END
