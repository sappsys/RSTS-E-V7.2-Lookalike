20 RANDOMIZE
30 READ S$(I) FOR I=1 TO 5
40 PRINT "SLOT MACHINE -- CHERRY LEMON BAR BELL SEVEN"
50 PRINT "YOU START WITH 20 COINS. BET 0 TO QUIT."
60 M=20
70 IF M>0 THEN 80
75 PRINT "THE HOUSE HAS YOUR COINS." \ GOTO 220
80 PRINT \ PRINT "COINS:"; M
90 INPUT "BET"; B
100 IF B=0 THEN 220
110 IF B>=0 AND B<=M THEN 120
115 PRINT "BETWEEN 0 AND"; M \ GOTO 90
120 A=INT(RND*5)+1 \ C=INT(RND*5)+1 \ D=INT(RND*5)+1
130 PRINT S$(A); " -- "; S$(C); " -- "; S$(D)
140 W=0
150 IF A<>C OR C<>D THEN 160
155 W=10*B \ GOTO 180
160 IF A=C OR C=D OR A=D THEN W=2*B
180 IF W<>0 THEN 190
185 PRINT "NOTHING." \ M=M-B \ GOTO 70
190 PRINT "YOU WIN"; W
200 M=M-B+W
210 GOTO 70
220 PRINT "YOU WALK AWAY WITH"; M
230 END
240 DATA "CHERRY","LEMON","BAR","BELL","SEVEN"
