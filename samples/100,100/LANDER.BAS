5 EXTEND
10 PRINT "LUNAR LANDER"
20 PRINT "ALTITUDE IN FEET, VELOCITY DOWN, FUEL UNITS. THRUST 0-30."
30 PRINT "TYPE -1 TO ABORT."
40 RANDOMIZE
50 A=500+INT(RND*200)
60 V=40+INT(RND*20)
70 F=120
80 T=0
90 PRINT
100 PRINT "TIME"; T; "  ALT"; INT(A); "  VEL"; INT(V); "  FUEL"; INT(F)
110 IF A<=0 THEN 200
120 IF F>0 THEN 130
125 PRINT "(OUT OF FUEL)" \ B=0 \ GOTO 160
130 INPUT "THRUST"; B
140 IF B=-1 THEN 230
150 IF B<0 THEN B=0
155 IF B>30 THEN B=30
156 IF B>F THEN B=F
160 F=F-B
170 V=V+4-B*.8
180 A=A-V
190 T=T+1
195 GOTO 90
200 IF V<=12 THEN 210
205 PRINT "YOU CRATERED AT"; INT(ABS(V)); "FT/SEC." \ GOTO 220
210 PRINT "A TEXTBOOK LANDING. THE EAGLE HAS LANDED."
220 INPUT "AGAIN (Y/N)"; A$
225 IF LEFT$(A$,1)="Y" OR LEFT$(A$,1)="y" THEN 50
230 PRINT "ENOUGH."
240 END
