5 EXTEND
10 PRINT "NIM -- 21 MATCHES. TAKE 1 TO 3. THE LAST MATCH WINS."
20 PRINT "TYPE 0 TO QUIT."
30 RANDOMIZE
40 N=21
50 PRINT
60 PRINT N; "LEFT"
80 INPUT "HOW MANY"; T
90 IF T=0 THEN 220
100 IF T=INT(T) AND T>=1 AND T<=3 AND T<=N THEN 110
105 PRINT "1, 2 OR 3." \ GOTO 80
110 N=N-T
120 IF N<>0 THEN 130
125 PRINT "YOU TAKE THE LAST MATCH. YOU WIN." \ GOTO 210
130 C=N-4*INT(N/4)
140 IF C=0 THEN C=1
150 IF C>N THEN C=N
160 PRINT "I TAKE"; C
170 N=N-C
180 IF N<>0 THEN 50
185 PRINT "I TAKE THE LAST MATCH. I WIN."
210 INPUT "AGAIN (Y/N)"; A$
215 IF LEFT$(A$,1)="Y" OR LEFT$(A$,1)="y" THEN 40
220 PRINT "ENOUGH."
230 END
