PROGRAM BAGELS(INPUT, OUTPUT);
VAR SEED, D1, D2, D3, G, G1, G2, G3, N, FERMI, PICO, I: INTEGER;
    DONE: BOOLEAN;
FUNCTION RND(N: INTEGER): INTEGER;
BEGIN
  SEED := (SEED * 25173 + 13849) MOD 65536;
  IF N < 1 THEN RND := 0 ELSE RND := SEED MOD N + 1
END;
BEGIN
  WRITELN('BAGELS: GUESS A 3-DIGIT NUMBER. DIGITS ARE DISTINCT.');
  WRITELN('FERMI = RIGHT DIGIT, RIGHT PLACE. PICO = RIGHT DIGIT,');
  WRITELN('WRONG PLACE. BAGELS = NONE. 0 GIVES UP.');
  WRITE('SEED? ');
  READLN(SEED);
  IF SEED < 1 THEN SEED := 1;
  D1 := RND(9);
  REPEAT D2 := RND(10) - 1 UNTIL D2 <> D1;
  REPEAT D3 := RND(10) - 1 UNTIL (D3 <> D1) AND (D3 <> D2);
  N := 0;
  DONE := FALSE;
  REPEAT
    WRITE('YOUR GUESS? ');
    READLN(G);
    IF G = 0 THEN
    BEGIN
      WRITELN('THE NUMBER WAS ', D1, D2, D3);
      DONE := TRUE
    END
    ELSE
    BEGIN
      N := N + 1;
      G1 := G DIV 100;
      G2 := (G DIV 10) MOD 10;
      G3 := G MOD 10;
      FERMI := 0;
      PICO := 0;
      IF G1 = D1 THEN FERMI := FERMI + 1
      ELSE IF (G1 = D2) OR (G1 = D3) THEN PICO := PICO + 1;
      IF G2 = D2 THEN FERMI := FERMI + 1
      ELSE IF (G2 = D1) OR (G2 = D3) THEN PICO := PICO + 1;
      IF G3 = D3 THEN FERMI := FERMI + 1
      ELSE IF (G3 = D1) OR (G3 = D2) THEN PICO := PICO + 1;
      IF FERMI = 3 THEN
      BEGIN
        WRITELN('YOU GOT IT IN ', N, ' GUESSES.');
        DONE := TRUE
      END
      ELSE IF (FERMI = 0) AND (PICO = 0) THEN
        WRITELN('BAGELS')
      ELSE
      BEGIN
        FOR I := 1 TO FERMI DO WRITE('FERMI ');
        FOR I := 1 TO PICO DO WRITE('PICO ');
        WRITELN
      END
    END
  UNTIL DONE
END.
