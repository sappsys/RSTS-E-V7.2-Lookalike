5 EXTEND
10 DIM W$(15)
20 RANDOMIZE
30 RESTORE \ READ W$(I) FOR I=1 TO 15
40 PRINT "HANGMAN. GUESS THE WORD, ONE LETTER AT A TIME."
50 PRINT "TYPE * TO QUIT."
60 W$=W$(INT(RND*15)+1)
70 L=LEN(W$) \ M=0 \ U$=""
80 G$=STRING$(L,"-")
90 PRINT \ PRINT G$; "   MISSED:"; M; "  USED: "; U$
100 IF G$<>W$ THEN 110
105 PRINT "YOU GOT IT -- "; W$ \ GOTO 250
110 IF M<7 THEN 120
115 PRINT "THE WORD WAS "; W$ \ GOTO 250
120 INPUT "LETTER"; C$
130 IF C$="*" THEN 260
140 IF C$="" THEN 120
150 C$=LEFT$(C$,1)
160 IF C$>="a" AND C$<="z" THEN C$=CHR$(ASC(C$)-32)
170 IF INSTR(U$,C$)=0 THEN 180
175 PRINT "YOU TRIED THAT." \ GOTO 120
180 U$=U$+C$
190 K=0
200 FOR I=1 TO L
210 IF MID$(W$,I,1)<>C$ THEN 220
215 MID$(G$,I,1)=C$ \ K=K+1
220 NEXT I
230 IF K<>0 THEN 240
235 M=M+1 \ PRINT "NO."
240 GOTO 90
250 INPUT "AGAIN (Y/N)"; A$
255 IF LEFT$(A$,1)="Y" OR LEFT$(A$,1)="y" THEN 60
260 PRINT "ENOUGH."
270 END
280 DATA "APPLE","BANANA","ORANGE","PLANET","ROCKET"
290 DATA "GALAXY","BINARY","PASCAL","FORTRAN","WUMPUS"
300 DATA "ADVENT","TERMINAL","KEYBOARD","PROGRAM","COMPUTER"
