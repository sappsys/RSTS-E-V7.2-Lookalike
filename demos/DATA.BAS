5 EXTEND
10 OPEN "DATA.TMP" AS FILE 1%, ORGANIZATION VIRTUAL
20 MAP (DATMAP) LONG X%, STRING A$ = 20
30 FOR I% = 1% TO 1000%
40   X% = I% * 5% \ A$ = "Record #" + NUM1$(I%)
50   PUT #1%, RECORD I%
60 NEXT I%
70 CLOSE #1%
80 OPEN "DATA.TMP" AS FILE 1%, ORGANIZATION VIRTUAL
90 MAP (DATMAP) LONG X%, STRING A$ = 20
100 PRINT "READING BACK 1000 RECORDS"
110 FOR I% = 1% TO 1000%
120   GET #1%, RECORD I%
130   PRINT X%; A$
140 NEXT I%
150 CLOSE #1%
160 END
