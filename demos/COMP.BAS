1110 LN%=1110 \ C%=(ABS(LOG(EXP(1))-1)<1E-5) \ GOSUB 9000
1120 LN%=1120 \ C%=(ABS(LOG10(100)-2)<1E-5) \ GOSUB 9000
1130 LN%=1130 \ C%=(EXP(0)=1) \ GOSUB 9000
1140 LN%=1140 \ C%=(ABS(SIN(0))<1E-8) AND (ABS(COS(0)-1)<1E-8) \ GOSUB 9000
1150 LN%=1150 \ C%=(ABS(TAN(0))<1E-8) AND (ABS(ATN(0))<1E-8) \ GOSUB 9000
1160 LN%=1160 \ C%=(ABS(ATN(1)*4-PI)<1E-5) \ GOSUB 9000
