5850 PV%=CVT$%(SYS(CHR$(6%)+CHR$(8%)))
5860 LN%=5860 \ C%=(PV%=0%) OR (PV%=-1%) \ GOSUB 9000
5870 LN%=5870 \ C%=(SYS(CHR$(6%)+CHR$(10%))="SY") \ GOSUB 9000
5880 LN%=5880 \ C%=(SYS(CHR$(6%)+CHR$(14%))="SY0:") \ GOSUB 9000
5890 LN%=5890 \ C%=(CVT$%(LEFT$(SYS(CHR$(6%)+CHR$(-10%)),2%))>0%) \ GOSUB 9000
5895 EC%=ASC(SYS(CHR$(6%)+CHR$(-2%)))
