1268 A,B=7 \ LN%=1268 \ C%=(A=7) AND (B=7) \ GOSUB 9000
1270 LN%=1270 \ C%=(2**3=8) AND (ASCII("A")=65) \ GOSUB 9000
1272 LN%=1272 \ C%=((1=1)=-1) AND ((1=0)=0) \ GOSUB 9000
1280 LN%=1280 \ C%=(5>3) AND (3<5) AND (5>=5) AND (3<=5) AND (1<>0) \ GOSUB 9000
1290 LN%=1290 \ C%=((1=1) AND (2=2)) AND (NOT (1=0)) \ GOSUB 9000
1300 LN%=1300 \ C%=("A"<"B") AND ("Z">"A") AND ("HI"="HI") \ GOSUB 9000
