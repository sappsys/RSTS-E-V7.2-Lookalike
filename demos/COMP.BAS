6510 CLOSE 1
6520 OPEN "COMPA.TMP" AS FILE 1
6530 LN%=6530 \ C%=(SPEC%(1%,0%)>0%) \ GOSUB 9000
6540 CLOSE 1
6550 OPEN "COMPA.TMP" FOR OUTPUT AS FILE 1
6560 PRINT #1, "OLD"
6570 CLOSE 1
6580 OPEN "COMPA.TMP" FOR INPUT AS FILE 1, MODE 1%
6590 LINE INPUT #1, U$
6600 PRINT #1, "NEW"
