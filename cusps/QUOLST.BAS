10 EXTEND
20 DIM SW$(20), SV$(20)
30 C$=SYS(CHR$(6%)+CHR$(-18%))
40 GOSUB 8000
50 K$="SET" \ M%=2% \ GOSUB 8300 \ IF Z% THEN X$=SYS(CHR$(6%)+CHR$(-30%)+"/SET "+ARG$) \ PRINT X$; \ END
60 R$=SYS(CHR$(6%)+CHR$(-30%)+ARG$)
70 N%=1% \ GOSUB 9000 \ PPN$=F$ \ N%=2% \ GOSUB 9000 \ NM$=F$
80 N%=3% \ GOSUB 9000 \ QU%=VAL(F$) \ N%=4% \ GOSUB 9000 \ U%=VAL(F$)
90 N%=5% \ GOSUB 9000 \ JQ%=VAL(F$) \ N%=6% \ GOSUB 9000 \ NJ%=VAL(F$)
100 PRINT PPN$; "  "; NM$
110 IF QU%<=0% THEN PRINT "Disk quota    unlimited    used "; NUM1$(U%) ELSE PRINT "Disk quota    "; NUM1$(QU%); "    used "; NUM1$(U%); "    free "; NUM1$(QU%-U%)
120 IF JQ%<=0% THEN PRINT "Job quota     unlimited    logged in "; NUM1$(NJ%) ELSE PRINT "Job quota     "; NUM1$(JQ%); "    logged in "; NUM1$(NJ%)
130 END
8000 ARG$="" \ NS%=0% \ I%=1%
8010 IF I%>LEN(C$) THEN GOSUB 8520 \ RETURN
8020 CH$=MID$(C$,I%,1)
8030 IF CH$="/" THEN 8100
8040 ARG$=ARG$+CH$ \ I%=I%+1% \ GOTO 8010
8100 I%=I%+1% \ NM$="" \ VL$=""
8110 IF I%>LEN(C$) THEN 8190
8120 CH$=MID$(C$,I%,1)
8130 IF CH$="/" OR CH$=" " OR CH$=CHR$(9) OR CH$="=" OR CH$=":" THEN 8140
8135 NM$=NM$+CH$ \ I%=I%+1% \ GOTO 8110
8140 IF CH$<>":" AND CH$<>"=" THEN 8190
8150 I%=I%+1%
8160 IF I%>LEN(C$) THEN 8190
8170 CH$=MID$(C$,I%,1)
8180 IF CH$="/" OR CH$=" " OR CH$=CHR$(9) THEN 8190
8185 VL$=VL$+CH$ \ I%=I%+1% \ GOTO 8160
8190 IF NM$="" THEN 8010
8192 GOSUB 8400
8195 NS%=NS%+1% \ SW$(NS%)=NM$ \ SV$(NS%)=VL$ \ GOTO 8010
8300 Z%=0%
8310 FOR J%=1% TO NS%
8320 IF LEN(SW$(J%))<M% THEN 8350
8330 IF LEFT$(K$,LEN(SW$(J%)))=SW$(J%) THEN Z%=-1% \ RETURN
8350 NEXT J%
8360 RETURN
8400 FOR J%=1% TO LEN(NM$)
8410 A%=ASC(MID$(NM$,J%,1))
8420 IF A%>=97 AND A%<=122 THEN MID$(NM$,J%,1)=CHR$(A%-32)
8430 NEXT J%
8440 RETURN
8520 IF ARG$="" THEN RETURN
8530 IF LEFT$(ARG$,1)=" " THEN ARG$=RIGHT$(ARG$,2) \ GOTO 8520
8540 IF MID$(ARG$,LEN(ARG$),1)=" " THEN ARG$=LEFT$(ARG$,LEN(ARG$)-1) \ GOTO 8520
8550 RETURN
9000 F$="" \ P%=1% \ C%=0% \ S$=R$+"|"
9010 Q%=INSTR(P%,S$,"|")
9020 IF Q%=0 THEN RETURN
9030 C%=C%+1%
9040 IF C%<>N% THEN P%=Q%+1% \ GOTO 9010
9050 F$=MID$(S$,P%,Q%-P%)
9060 RETURN
