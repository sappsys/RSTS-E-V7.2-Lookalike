360 GOTO 340
370 CLOSE 1% \ CLOSE 2%
380 END
1800 C$=ARG$
1810 FOR J%=1% TO NS%
1820 C$=C$+"/"+SW$(J%)
1830 NEXT J%
1840 CHAIN "$DIRECT"
1900 IF ERR=11 THEN CLOSE 1% \ CLOSE 2% \ RESUME 380
1905 IF ERR=16 THEN PRINT "?Name or account now exists" \ RESUME 380
1910 PRINT "?Can't find file or account"
1920 RESUME 380
2000 IF ARG$="" THEN PRINT "?PIP/DE filespec" \ END
2010 IF INSTR(ARG$,"*")=0 THEN IF INSTR(ARG$,"?")=0 THEN KILL ARG$ \ END
2020 D$=SYS(CHR$(6%)+CHR$(-20%)+ARG$) \ DP%=1%
2030 GOSUB 9300
2040 IF Z%=0% THEN END
2050 N%=1% \ GOSUB 9000 \ NM$=F$ \ N%=2% \ GOSUB 9000
2060 KILL NM$+"."+F$
2070 GOTO 2030
2200 EQ%=INSTR(ARG$,"=")
2210 IF EQ%=0% THEN PRINT "?PIP/RE new=old" \ END
2220 DST$=LEFT$(ARG$,EQ%-1%) \ SRC$=RIGHT$(ARG$,EQ%+1%)
2230 NAME SRC$ AS DST$
2240 END
2400 OPEN DST$ FOR OUTPUT AS FILE 2%
2410 S$=SRC$+","
2420 P%=1%
2430 Q%=INSTR(P%,S$,",")
