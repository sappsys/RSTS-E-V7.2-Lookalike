85 IF Z%=0% THEN K$="DE" \ M%=2% \ GOSUB 8300
90 IF Z% THEN 2000
100 K$="LIST" \ M%=2% \ GOSUB 8300 \ IF Z% THEN 1800
110 K$="DIR" \ M%=2% \ GOSUB 8300 \ IF Z% THEN 1800
120 K$="WIDE" \ M%=1% \ GOSUB 8300 \ IF Z% THEN 1800
130 K$="BRIEF" \ M%=2% \ GOSUB 8300 \ IF Z% THEN 1800
140 K$="RENAME" \ M%=2% \ GOSUB 8300 \ IF Z% THEN 2200
150 EQ%=INSTR(ARG$,"=")
160 IF EQ%=0% THEN PRINT "?PIP dst=src" \ END
170 DST$=LEFT$(ARG$,EQ%-1%) \ SRC$=RIGHT$(ARG$,EQ%+1%)
