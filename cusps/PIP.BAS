2470 OPEN F1$ FOR INPUT AS FILE 1%
2480 ON ERROR GOTO 2520
2490 LINE INPUT #1%, L$
2500 PRINT #2%, L$
2510 GOTO 2490
2520 IF ERR=11 THEN CLOSE 1% \ RESUME 2430
2530 PRINT "?Can't find file or account"
2540 RESUME 2430
7000 PRINT "PIP dst=src [/AP] [/NE] [/PROT:n] [/GO]"
7010 PRINT "PIP/DE filespec             delete"
7020 PRINT "PIP/LI filespec             list (same as DIR)"
7030 PRINT "PIP/DI filespec             same as /LI"
7040 PRINT "PIP/WI  PIP/BR              wide / brief list"
7050 PRINT "PIP/RE new=old              rename"
7060 PRINT "PIP dst=src1,src2           concatenate"
7070 PRINT "PIP/AP dst=src              append copy"
7080 PRINT "PIP/NE dst=src              no supersede"
7090 PRINT "PIP/PROT:n dst=src          set destination protection"
7100 PRINT "PIP/GO                      continue after errors"
7110 PRINT "PIP/RW  PIP/DEN             magtape (accepted)"
7120 END
8000 ARG$="" \ NS%=0% \ I%=1%
8010 IF I%>LEN(C$) THEN GOSUB 8520 \ RETURN
8020 CH$=MID$(C$,I%,1)
8030 IF CH$="/" THEN 8100
8040 ARG$=ARG$+CH$ \ I%=I%+1% \ GOTO 8010
8100 I%=I%+1% \ NM$="" \ VL$=""
8110 IF I%>LEN(C$) THEN 8190
8120 CH$=MID$(C$,I%,1)
8130 IF CH$="/" OR CH$=" " OR CH$=CHR$(9) OR CH$="=" OR CH$=":" THEN 8140
8135 NM$=NM$+CH$ \ I%=I%+1% \ GOTO 8110
8140 IF CH$<>":" AND CH$<>"=" THEN 8190
8150 I%=I%+1%
8160 IF I%>LEN(C$) THEN 8190
8170 CH$=MID$(C$,I%,1)
8180 IF CH$="/" OR CH$=" " OR CH$=CHR$(9) THEN 8190
8185 VL$=VL$+CH$ \ I%=I%+1% \ GOTO 8160
8190 IF NM$="" THEN 8010
8192 GOSUB 8400
8195 NS%=NS%+1% \ SW$(NS%)=NM$ \ SV$(NS%)=VL$ \ GOTO 8010
8300 Z%=0%
8310 FOR J%=1% TO NS%
8320 IF LEN(SW$(J%))<M% THEN 8350
8330 IF LEFT$(K$,LEN(SW$(J%)))=SW$(J%) THEN Z%=-1% \ RETURN
8350 NEXT J%
8360 RETURN
8400 FOR J%=1% TO LEN(NM$)
8410 A%=ASC(MID$(NM$,J%,1))
8420 IF A%>=97 AND A%<=122 THEN MID$(NM$,J%,1)=CHR$(A%-32)
8430 NEXT J%
8440 RETURN
8520 IF ARG$="" THEN RETURN
8530 IF LEFT$(ARG$,1)=" " THEN ARG$=RIGHT$(ARG$,2) \ GOTO 8520
8540 IF MID$(ARG$,LEN(ARG$),1)=" " THEN ARG$=LEFT$(ARG$,LEN(ARG$)-1) \ GOTO 8520
8550 RETURN
8555 IF T$="" THEN RETURN
8560 IF LEFT$(T$,1)=" " THEN T$=RIGHT$(T$,2) \ GOTO 8555
8570 IF MID$(T$,LEN(T$),1)=" " THEN T$=LEFT$(T$,LEN(T$)-1) \ GOTO 8555
8580 RETURN
8700 FOR J%=1% TO NS%
8710 IF LEFT$("PROTECTION",LEN(SW$(J%)))=SW$(J%) AND LEN(SW$(J%))>=2 THEN RETURN
8720 IF LEFT$("PROT",LEN(SW$(J%)))=SW$(J%) AND LEN(SW$(J%))>=2 THEN RETURN
8730 NEXT J%
8740 RETURN
9000 F$="" \ P%=1% \ C%=0% \ S$=R$+"|"
9010 Q%=INSTR(P%,S$,"|")
9020 IF Q%=0 THEN RETURN
9030 C%=C%+1%
9040 IF C%<>N% THEN P%=Q%+1% \ GOTO 9010
9050 F$=MID$(S$,P%,Q%-P%)
9060 RETURN
9300 Z%=0%
9310 IF D$="" THEN RETURN
9320 IF DP%>LEN(D$) THEN RETURN
9330 Q%=INSTR(DP%,D$+CHR$(10),CHR$(10))
9340 IF Q%=0 THEN RETURN
9350 R$=MID$(D$,DP%,Q%-DP%)
9360 DP%=Q%+1%
9370 IF R$="" THEN 9320
9380 Z%=-1%
9390 RETURN
